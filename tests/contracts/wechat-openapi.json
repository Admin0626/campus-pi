{
  "openapi": "3.0.3",
  "info": {
    "title": "Campus Pi WeChat account extension",
    "version": "1.0.0",
    "description": "Supplement to the 112-operation baseline. Explicit binding only; never auto-create users. Apply V008 before enabling. Does not contain any real AppID or secret."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/wechat/config": {
      "get": {
        "operationId": "WX001",
        "summary": "Read whether backend WeChat exchange is configured",
        "tags": [
          "A account WeChat extension"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data",
                    "request_id"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Capabilities"
                    }
                  }
                }
              }
            }
          }
        },
        "x-owner": "A",
        "x-runtime-evidence": "Real HTTP + isolated MySQL with mocked external WeChat exchange; no live WeChat exchange accepted"
      }
    },
    "/auth/wechat/login": {
      "post": {
        "operationId": "WX002",
        "summary": "Sign in an already bound campus account",
        "tags": [
          "A account WeChat extension"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data",
                    "request_id"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/LoginResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or expired code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not bound or disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Binding ownership conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Exchange rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "501": {
            "description": "WeChat not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-owner": "A",
        "x-runtime-evidence": "Real HTTP + isolated MySQL with mocked external WeChat exchange; no live WeChat exchange accepted",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequest"
              }
            }
          }
        }
      }
    },
    "/me/wechat": {
      "get": {
        "operationId": "WX003",
        "summary": "Read current account binding status",
        "tags": [
          "A account WeChat extension"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data",
                    "request_id"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/BindingStatus"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-owner": "A",
        "x-runtime-evidence": "Real HTTP + isolated MySQL with mocked external WeChat exchange; no live WeChat exchange accepted"
      },
      "post": {
        "operationId": "WX004",
        "summary": "Actively bind the current WeChat to the authenticated account",
        "tags": [
          "A account WeChat extension"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data",
                    "request_id"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "OK"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/BindingResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or expired code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not bound or disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Binding ownership conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Exchange rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "501": {
            "description": "WeChat not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-owner": "A",
        "x-runtime-evidence": "Real HTTP + isolated MySQL with mocked external WeChat exchange; no live WeChat exchange accepted",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CodeRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Capabilities": {
        "type": "object",
        "required": [
          "available"
        ],
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          }
        }
      },
      "BindingStatus": {
        "type": "object",
        "required": [
          "available"
        ],
        "additionalProperties": false,
        "properties": {
          "available": {
            "type": "boolean"
          },
          "bound": {
            "type": "boolean",
            "description": "Only returned when available is true"
          },
          "bound_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BindingResult": {
        "type": "object",
        "required": [
          "bound"
        ],
        "additionalProperties": false,
        "properties": {
          "bound": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        }
      },
      "CodeRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Fresh one-use code obtained by wx.login. Never submit openid or account ID."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "request_id",
          "errors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          },
          "request_id": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "LoginResult": {
        "$ref": "./campus-pi-openapi.json#/components/schemas/LoginResult"
      }
    }
  }
}
