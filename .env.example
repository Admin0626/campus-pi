# Documentation template. Copy selected entries into each application's config.
# Spring Boot reads environment variables directly; it does not auto-load this file.
SERVER_PORT=8080
# Database and account configuration. Never commit real values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_pi_local
DB_USER=
DB_PASSWORD=
AUTH_IDEMPOTENCY_SECRET=
# Backend only. Apply V008 before enabling. Never put AppSecret in the mini-program.
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Apply V004/V005 before enabling the durable in-app worker.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_POLL_INTERVAL_MS=2000
