.state-panel{padding:38rpx 30rpx;text-align:center;color:#8b8b99;background:#fafafa;border:2rpx solid #eee;border-radius:19rpx;box-sizing:border-box}
.state-title{font-size:28rpx;line-height:1.6}.state-message{font-size:24rpx;line-height:1.8;margin-top:16rpx}
button{font-size:25rpx;color:#5000ff;background:#fff;border:1rpx solid #ded9ff;border-radius:12rpx;margin:24rpx auto 0;padding:12rpx 24rpx;line-height:1.5;width:fit-content}button::after{border:0}
