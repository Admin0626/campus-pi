.business {
  padding: 28rpx 28rpx 180rpx;
  background: #f7f8fc;
  min-height: 100vh;
  color: #26334b;
  box-sizing: border-box;
  font-size: 28rpx;
  width: 100%;
  min-width: 0;
  line-height: 1.6;
}
.heading {
  font-size: 38rpx;
  font-weight: 600;
  padding: 10rpx 0 25rpx;
}
.toolbar {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin: 20rpx 0 8rpx;
  min-width: 0;
}
.toolbar button,
button {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 72rpx;
  height: auto;
  font-size: 25rpx;
  background: white;
  color: #6551b9;
  border: 1rpx solid #e1ddeb;
  border-radius: 12rpx;
  margin: 0;
  padding: 12rpx 18rpx;
  line-height: 1.4;
  white-space: normal;
  word-break: break-all;
}
.toolbar > button {
  flex: 0 0 auto;
  margin: 0 12rpx 12rpx 0;
}
.toolbar > button:last-child {
  margin-right: 0;
}
.toolbar > input {
  flex: 1 1 260rpx;
  width: 0;
  min-width: 0;
  margin: 0 12rpx 12rpx 0;
}
.search-toolbar {
  align-items: stretch;
}
.search-toolbar > button {
  min-height: 96rpx;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.5;
}
.toolbar .active,
.toolbar .primary,
.primary {
  background: #7757e6;
  color: white;
}
.card {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  background: white;
  border: 1rpx solid #eceaf2;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 24rpx 0;
}
.row-title {
  font-weight: 600;
  font-size: 30rpx;
  word-break: break-all;
  line-height: 1.5;
}
.heading,
.row-title,
.muted,
.copy,
.price,
.error,
.notice,
.field label,
.picker {
  min-width: 0;
  max-width: 100%;
  word-break: break-all;
  overflow-wrap: break-word;
}
.muted {
  font-size: 24rpx;
  color: #7a8495;
  line-height: 1.8;
  margin: 10rpx 0;
}
.copy {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  line-height: 1.7;
}
.price {
  color: #dc655d;
  font-size: 36rpx;
  margin: 14rpx 0;
}
.error,
.notice {
  padding: 24rpx;
  border-radius: 12rpx;
  margin: 18rpx 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.error {
  background: #fff0f3;
  color: #a93049;
}
.notice {
  background: #eaf9f2;
  color: #246856;
}
.field {
  margin: 24rpx 0;
}
.field label {
  display: block;
  margin-bottom: 12rpx;
}
input,
textarea,
.picker {
  padding: 20rpx;
  border: 1rpx solid #dddce8;
  border-radius: 12rpx;
  background: white;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
}
input {
  /* Native input has a fixed default height; vertical padding clips its text. */
  height: 96rpx;
  min-height: 96rpx;
  padding: 0 20rpx;
}
.picker {
  min-height: 96rpx;
  white-space: normal;
}
textarea {
  min-height: 260rpx;
  line-height: 1.6;
}
.detail-line {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}
.pager {
  flex-wrap: nowrap;
  justify-content: space-between;
  font-size: 24rpx;
  width: 100%;
}
.pager > button,
.pager > button:last-child {
  flex: 0 0 28%;
  width: 28%;
  margin: 0;
  padding-left: 8rpx;
  padding-right: 8rpx;
}
.pager-summary {
  flex: 1 1 0;
  min-width: 0;
  margin: 0 12rpx;
  text-align: center;
  white-space: normal;
  word-break: break-all;
}
.bubble {
  max-width: 90%;
  box-sizing: border-box;
}
.mine {
  margin-left: auto;
  background: #eee8ff;
}

@media (max-width: 350px) {
  button {
    font-size: 28rpx;
    min-height: 84rpx;
  }
  .pager-summary {
    font-size: 26rpx;
  }
}

@import "../../styles/tab-layout.wxss";
