.word-label {
  display: block;
  margin-bottom: 13.39rpx;
  font-size: 26.79rpx;
  line-height: 1.4;
  color: #333;
}

.word-input {
  border: 2rpx solid #a0a0a0;
  border-radius: 10.71rpx;
  height: 80.36rpx;
  display: flex;
  align-items: center;
  padding: 0 16.07rpx;
  gap: 14.73rpx;
  background: #fff;
}

.word-input input {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100%;
  font-size: 26.79rpx;
  color: #333;
}

.word-symbol {
  color: #666;
  font-size: 29.46rpx;
  width: 29.46rpx;
  flex-shrink: 0;
  text-align: center;
}

.word-eye {
  color: #666;
  font-size: 30rpx;
  width: 34rpx;
}


