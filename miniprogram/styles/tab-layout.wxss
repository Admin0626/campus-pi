/* Shared by page styles and isolated components: fixed bar + safe area + gap. */
.business,
.word-home-page,
.word-me-page,
.main-placeholder {
  padding-bottom: 180rpx;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.word-mobile-tabs {
  box-sizing: border-box;
  position: fixed;
  bottom: 0;
  z-index: 20;
  height: 148rpx;
  height: calc(148rpx + constant(safe-area-inset-bottom));
  height: calc(148rpx + env(safe-area-inset-bottom));
  padding-bottom: 34rpx;
  padding-bottom: calc(34rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}
