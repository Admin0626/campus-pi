page{background:#f6f8fc;color:#1c2738;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}view,input,button{box-sizing:border-box}button::after{border:0}button{font-size:28rpx;line-height:1.5;border-radius:12rpx}button[disabled]{opacity:.55}.page{padding:50rpx 40rpx}.auth{min-height:100vh;background:#fff;padding:70rpx 54rpx 50rpx}.brand{text-align:center;color:#3b55c6;font-size:60rpx;font-weight:600;margin:25rpx 0 70rpx}.title{text-align:center;font-weight:600;font-size:42rpx}.subtitle{text-align:center;color:#8291aa;font-size:24rpx;margin:22rpx 0 65rpx}.field{margin-bottom:38rpx}.label{display:block;color:#40516e;font-size:25rpx;margin-bottom:17rpx}.input{width:100%;height:94rpx;background:white;border:1rpx solid #dbe2ee;border-radius:12rpx;padding:0 24rpx;font-size:27rpx}.primary{display:flex;align-items:center;justify-content:center;background:#3b55c6;color:white;min-height:92rpx;border:0;margin-top:36rpx}.secondary{background:white;color:#61769f;border:1rpx solid #dce3ee;padding:21rpx 30rpx}.links{display:flex;align-items:center;justify-content:center;gap:15rpx;font-size:24rpx;color:#94a2b8;margin-top:40rpx}.link{color:#3b55c6}.error{padding:23rpx;background:#fff0f1;color:#b64a55;font-size:24rpx;border-radius:12rpx;margin-bottom:28rpx;line-height:1.8}.note{text-align:center;color:#8d9cb4;font-size:23rpx;line-height:1.8;margin-top:42rpx}.tabs{display:flex;gap:20rpx;margin-bottom:16rpx;color:#9aa8c0;font-size:24rpx}.tabs .active{color:#3b55c6}.hint{font-size:21rpx;color:#8a9bb6;margin-top:12rpx}.card{background:#fff;border:1rpx solid #e4eaf4;border-radius:18rpx;padding:36rpx;margin-bottom:30rpx}.heading{font-size:38rpx;font-weight:600;margin-bottom:30rpx}.card-title{font-size:31rpx;font-weight:500}.description{font-size:24rpx;line-height:1.9;color:#899bb6;margin:22rpx 0}.modules{display:flex;flex-direction:column;gap:24rpx}.module{display:flex;align-items:center;justify-content:space-between;text-align:left;font-size:28rpx}.tag{background:#f0f3f9;font-size:21rpx;color:#95a3b9;padding:8rpx 14rpx;border-radius:7rpx}.row{display:flex;justify-content:space-between;gap:28rpx;border-bottom:1rpx solid #edf0f6;padding:28rpx 0;font-size:25rpx;line-height:1.8}.row .key{color:#8a9cb7;flex-shrink:0}.row .value{word-break:break-all}.center{text-align:center}.space{height:40rpx}
