<view class="page"><view class="heading">我的账号</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{user}}" class="card"><view class="card-title">{{user.username}}</view><view class="row"><text class="key">用户编号</text><text class="value">{{user.user_id}}</text></view><view class="row"><text class="key">邮箱</text><text class="value">{{user.email||'未绑定'}}</text></view><view class="row"><text class="key">手机号</text><text class="value">{{user.phone||'未绑定'}}</text></view><view class="row"><text class="key">实名认证</text><text>{{user.identity_verification}}</text></view><view class="row"><text class="key">校园认证</text><text>{{user.campus_verification}}</text></view><view class="row"><text class="key">认证校区</text><text>{{user.campus||'尚未认证'}}</text></view><view class="note">资料与认证功能的移动端页面还在开发</view></view><button class="secondary" bindtap="logout" disabled="{{busy}}">退出登录</button></view>
