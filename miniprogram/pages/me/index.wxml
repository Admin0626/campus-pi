<view class="word-native-screen"><view style="height:{{statusHeight}}px;background:#5446b9"></view><view wx:if="{{error}}" class="word-native-error">{{error}}</view><view wx:if="{{user}}" class="word-me-page"><view class="word-me-header"><view class="word-me-identity"><view class="word-me-avatar">♙</view><view><view class="word-user-name">{{user.username}}</view><view class="word-student">学号：—</view><view class="word-cert">{{user.identity_verification==='已通过'?'已认证':'未认证'}}<text class="word-chip">✓ {{user.campus_verification==='已通过'?user.campus:'未校园认证'}}</text></view></view></view><view class="word-me-statistics"><button wx:for="{{['发布商品','发布帖子','发布商品']}}" wx:key="index" data-name="发布统计" bindtap="pending"><text class="word-number">—</text><text class="word-stat-label">{{item}}</text></button></view></view><view class="word-me-card"><view class="word-card-title">我的服务</view><view class="word-me-services"><button data-name="我的发布" bindtap="pending">我的发布</button><button data-name="我的收藏" bindtap="pending">我的收藏</button><button data-name="订单管理" bindtap="pending">订单管理</button><button data-name="任务记录" bindtap="pending">任务记录</button></view></view><view class="word-me-card word-me-settings"><view class="word-card-title">设置</view><button data-name="账号设置" bindtap="pending">账号设置<text>›</text></button><button data-name="通知中心" bindtap="pending">通知中心<text>›</text></button><button data-name="隐私安全" bindtap="pending">隐私安全<text>›</text></button></view><button class="word-me-logout" bindtap="logout" disabled="{{busy}}">退出登录</button></view><view class="word-mobile-tabs"><button  bindtap="home"><text class="word-native-icon">⌂</text>首页</button><button data-name="校园帖子" bindtap="pending"><text class="word-native-icon">◉</text>发现</button><button class="word-tab-publish" data-name="发布信息" bindtap="pending">＋</button><button data-name="私信与举报" bindtap="pending"><text class="word-native-icon">☏</text>私信</button><button class="selected" bindtap="noop"><text class="word-native-icon">♙</text>个人</button></view></view>