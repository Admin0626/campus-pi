<view class="word-native-screen"><view style="height:{{statusHeight}}px;background:#5446b9"></view><state-panel wx:if="{{error}}" title="加载失败" message="{{error}}" action="重试" bind:action="onShow"/><view wx:if="{{user}}" class="word-me-page"><view class="word-me-header"><view class="word-me-identity"><view class="word-me-avatar"><image wx:if="{{user.avatar_url}}" src="{{user.avatar_url}}" mode="aspectFill" style="width:100%;height:100%;border-radius:50%"/><text wx:else>♙</text></view><view><view class="word-user-name">{{user.username}}</view><view class="word-student">学号：—</view><view class="word-cert">{{user.identity_verification==='已通过'?'已认证':'未认证'}}<text class="word-chip">✓ {{user.campus_verification==='已通过'?user.campus:'未校园认证'}}</text></view></view></view><view class="word-me-statistics"><button wx:for="{{['发布商品','发布帖子','发布任务']}}" wx:key="index" data-module="{{index===0?'C':index===1?'D':'E'}}" bindtap="business"><text class="word-number">{{counts[index]}}</text><text class="word-stat-label">{{item}}</text></button></view></view><view class="word-me-card"><view class="word-card-title">我的服务</view><view class="word-me-services"><button data-module="D" bindtap="business">我的发布</button><button data-module="C" bindtap="business">我的收藏</button><button data-module="G" bindtap="business">订单管理</button><button data-module="F" bindtap="business">任务记录</button></view></view><view class="word-me-card word-me-settings"><view class="word-card-title">设置</view><button data-module="B" bindtap="business">实名与校园认证<text>›</text></button><button bindtap="wechatBinding">微信账号绑定<text>›</text></button><button data-module="A" bindtap="business">账号设置<text>›</text></button><button data-module="I" bindtap="business">通知中心<text>›</text></button><button data-module="S" bindtap="business">隐私安全<text>›</text></button></view><button class="word-me-logout" bindtap="logout" disabled="{{busy}}">退出登录</button></view></view>
