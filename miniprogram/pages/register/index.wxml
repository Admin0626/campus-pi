<view style="height:{{statusHeight}}px"></view><view class="word-auth word-register"><button class="word-back" bindtap="back"><text>◇</text>返回登录</button><view class="word-logo"><image src="/assets/word-reference/login.png"/></view><view class="word-title">立即注册</view><view class="word-field word-username"><auth-field name="username" label="用户名" glyph="user" value="{{username}}" placeholder="请输入学号或用户名" disabled="{{busy}}" bind:change="input"/></view><view class="word-field word-email"><auth-field name="email" label="邮箱" glyph="mail" value="{{email}}" placeholder="请输入邮箱" disabled="{{busy}}" bind:change="input"/></view><view class="word-field word-password"><auth-field name="password" label="密码" glyph="lock" value="{{password}}" placeholder="请输入密码" disabled="{{busy}}" bind:change="input" password revealed="{{revealed}}" bind:reveal="togglePassword"/></view><view class="word-field word-phone"><auth-field name="phone" label="手机号码" glyph="phone" value="{{phone}}" placeholder="请输入手机号" disabled="{{busy}}" bind:change="input"/></view><view class="word-field word-code"><view class="word-label">验证码</view><view class="word-code-row"><view class="word-input" bindtap="unavailable" data-name="验证码"><view class="word-glyph glyph-shield"><image src="/assets/word-reference/login.png"/></view><input placeholder="请输入验证码" disabled/></view><button class="word-code-button" bindtap="unavailable" data-name="获取验证码">获取验证码</button></view></view><view class="word-agreement"><button class="word-check" bindtap="unavailable" data-name="用户协议"><view class="word-check-box"></view>同意协议</button><button class="word-link" bindtap="unavailable" data-name="用户协议正文">同意协议</button></view><button class="word-submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交注册</button><view wx:if="{{error}}" class="word-feedback"><text>{{error}}</text><button bindtap="dismiss">×</button></view></view>
