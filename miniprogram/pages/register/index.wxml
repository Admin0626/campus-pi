<view class="auth"><view class="brand">校园Π</view><view class="title">注册账号</view><view class="subtitle">一个账号，开启校园生活</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="field"><label class="label" for="username">用户名</label><input id="username" class="input" value="{{username}}" data-field="username" bindinput="input" placeholder="以字母开头，3–25位字符" maxlength="-1" disabled="{{busy}}"/></view><view class="field"><view class="tabs"><text class="{{contactType==='email'?'active':''}}" data-type="email" bindtap="contactType">邮箱</text><text>/</text><text class="{{contactType==='phone'?'active':''}}" data-type="phone" bindtap="contactType">手机号</text></view><input class="input" value="{{contact}}" data-field="contact" bindinput="input" placeholder="{{contactType==='email'?'请输入常用邮箱':'+8613800000000'}}" maxlength="-1" disabled="{{busy}}"/><view class="hint">手机号或邮箱填写一项即可</view></view><view class="field"><label class="label" for="new-password">设置密码</label><input id="new-password" class="input" value="{{password}}" data-field="password" bindinput="input" password placeholder="12–64个字符" maxlength="-1" disabled="{{busy}}"/></view><view class="field"><label class="label" for="confirm">确认密码</label><input id="confirm" class="input" value="{{confirm}}" data-field="confirm" bindinput="input" password placeholder="请再次输入密码" maxlength="-1" disabled="{{busy}}"/></view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">注册账号</button><view class="note">注册成功后进入登录页面</view></view>
