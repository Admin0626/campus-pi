<view style="height:{{statusHeight}}px"></view><view class="word-auth word-register"><button class="word-back" bindtap="back"><text>◇</text>返回登录</button><view class="word-logo"><image src="/assets/word-reference/login.png"/></view><view class="word-title">立即注册</view><view class="word-field word-username"><label class="word-label" for="username">用户名</label><view class="word-input"><view class="word-glyph glyph-user"><image src="/assets/word-reference/login.png"/></view><input id="username" value="{{username}}" data-field="username" bindinput="input" placeholder="请输入学号或用户名" maxlength="-1" disabled="{{busy}}" /></view></view><view class="word-field word-email"><label class="word-label" for="email">邮箱</label><view class="word-input"><view class="word-glyph glyph-mail"><image src="/assets/word-reference/register.png"/></view><input id="email" value="{{email}}" data-field="email" bindinput="input" placeholder="请输入邮箱" maxlength="-1" disabled="{{busy}}" /></view></view><view class="word-field word-password"><label class="word-label" for="password">密码</label><view class="word-input"><view class="word-glyph glyph-lock"><image src="/assets/word-reference/login.png"/></view><input id="password" value="{{password}}" data-field="password" bindinput="input" placeholder="请输入密码" maxlength="-1" password="{{!revealed}}" disabled="{{busy}}" /><button class="word-eye" bindtap="togglePassword" aria-label="显示或隐藏密码"><view class="word-glyph glyph-eye"><image src="/assets/word-reference/login.png"/></view></button></view></view><view class="word-field word-phone"><label class="word-label" for="phone">手机号码</label><view class="word-input"><view class="word-glyph glyph-phone"><image src="/assets/word-reference/login.png"/></view><input id="phone" value="{{phone}}" data-field="phone" bindinput="input" placeholder="请输入手机号" maxlength="-1" disabled="{{busy}}" /></view></view><view class="word-field word-code"><view class="word-label">验证码</view><view class="word-code-row"><view class="word-input" bindtap="unavailable" data-name="验证码"><view class="word-glyph glyph-shield"><image src="/assets/word-reference/login.png"/></view><input placeholder="请输入验证码" disabled/></view><button class="word-code-button" bindtap="unavailable" data-name="获取验证码">获取验证码</button></view></view><view class="word-agreement"><button class="word-check" bindtap="unavailable" data-name="用户协议"><view class="word-check-box"></view>同意协议</button><button class="word-link" bindtap="unavailable" data-name="用户协议正文">同意协议</button></view><button class="word-submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交注册</button><view wx:if="{{error}}" class="word-feedback"><text>{{error}}</text><button bindtap="dismiss">×</button></view></view>