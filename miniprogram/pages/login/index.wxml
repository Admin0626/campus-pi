<view style="height:{{statusHeight}}px"></view><view class="word-auth word-login"><view class="word-logo"><image src="/assets/word-reference/login.png"/></view><view class="word-title">欢迎回来</view><view class="word-subtitle">登录您的校园账户</view><view class="word-field word-username"><auth-field name="account" label="学号/用户名" glyph="user" value="{{account}}" placeholder="请输入学号或用户名" disabled="{{busy}}" bind:change="input"/></view><view class="word-field word-password"><auth-field name="password" label="密码" glyph="lock" value="{{password}}" placeholder="请输入密码" disabled="{{busy}}" bind:change="input" password revealed="{{revealed}}" bind:reveal="togglePassword"/></view><view class="word-field word-phone"><auth-field name="phone" label="手机号码" glyph="phone" value="{{phone}}" placeholder="请输入手机号" disabled="{{busy}}" bind:change="input" readonly unavailable-name="手机验证码登录" bind:unavailable="unavailable"/></view><view class="word-field word-code"><view class="word-label">验证码</view><view class="word-code-row"><view class="word-input" bindtap="unavailable" data-name="验证码"><view class="word-glyph glyph-shield"><image src="/assets/word-reference/login.png"/></view><input placeholder="请输入验证码" disabled/></view><button class="word-code-button" bindtap="unavailable" data-name="获取验证码">获取验证码</button></view></view><view class="word-agreement"><button class="word-check" bindtap="unavailable" data-name="记住登录状态"><view class="word-check-box"></view>记住登录状态</button><button class="word-link" bindtap="forgot" data-name="用户协议正文">忘记密码?</button></view><button class="word-submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}"><view class="word-glyph glyph-login"><image src="/assets/word-reference/login.png"/></view>登录</button><view class="word-separator"><view></view>或使用第三方登录<view></view></view><view class="word-socials"><button class="word-social social-0" bindtap="wechatLogin" disabled="{{busy}}" aria-label="微信登录（需先绑定校园账号）"><image src="/assets/word-reference/login.png"/></button><button class="word-social social-1" bindtap="unavailable" data-name="QQ登录" aria-label="QQ登录（开发中）"><image src="/assets/word-reference/login.png"/></button><button class="word-social social-2" bindtap="unavailable" data-name="支付宝登录" aria-label="支付宝登录（开发中）"><image src="/assets/word-reference/login.png"/></button></view><view class="word-register-link">还没有账户？<button class="word-link" bindtap="register">立即注册</button></view><view class="word-certifications"><button bindtap="unavailable" data-name="实名认证">♙ 实名认证</button><button bindtap="unavailable" data-name="校区认证">♙ 校区认证</button></view><view wx:if="{{error}}" class="word-feedback"><text>{{error}}</text><button bindtap="dismiss">×</button></view></view>
