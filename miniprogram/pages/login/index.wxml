<view class="auth"><view class="brand">校园Π</view><view class="title">欢迎登录</view><view class="subtitle">使用用户名、手机号或邮箱登录</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="field"><label class="label" for="account">账号</label><input id="account" class="input" value="{{account}}" data-field="account" bindinput="input" placeholder="用户名 / 手机号 / 邮箱" maxlength="100" disabled="{{busy}}"/></view><view class="field"><label class="label" for="password">密码</label><input id="password" class="input" value="{{password}}" data-field="password" bindinput="input" password placeholder="请输入密码" maxlength="-1" disabled="{{busy}}"/></view><view class="links"><text class="link" bindtap="forgot">忘记密码？</text></view><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">登录</button><view class="links">还没有账号？<text class="link" bindtap="register">立即注册</text></view><view class="note">登录后可申请实名与校园认证</view></view>
