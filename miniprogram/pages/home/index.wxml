<view class="word-native-screen"><view style="height:{{statusHeight}}px;background:#7872df"></view><view class="word-home-page"><view class="word-home-header"><button class="word-home-search" data-module="D" bindtap="business">⌕　搜索信息、商品或任务..</button><view class="word-home-shortcuts"><button data-module="D" bindtap="business"><view>＋</view>发布信息</button><button data-module="C" bindtap="business"><view>♙</view>二手交易</button><button data-module="E" bindtap="business"><view>♧</view>悬赏任务</button><button data-module="D" bindtap="business"><view>♙</view>交友广场</button></view></view><view class="word-home-categories"><button class="selected" data-module="D" bindtap="business">推荐</button><button data-module="D" bindtap="business">失物招领</button><button data-module="D" bindtap="business">活动宣传</button></view><view wx:if="{{error}}">{{error}}</view><view wx:if="{{loading}}">正在加载…</view><view class="word-home-panel"><view><view class="word-panel-title">校园信息</view><button data-module="D" bindtap="business">查看更多</button></view><button wx:for="{{posts}}" wx:key="post_id" data-module="D" bindtap="business">{{item.post_title}}</button><view wx:if="{{!loading&&!posts.length}}">暂无公开帖子</view></view><view class="word-home-panel"><view><view class="word-panel-title">二手交易</view><button data-module="C" bindtap="business">查看更多</button></view><button wx:for="{{products}}" wx:key="product_id" data-module="C" bindtap="business">{{item.product_name}}　¥{{item.discount_price}}</button><view wx:if="{{!loading&&!products.length}}">暂无在售商品</view></view></view></view>
