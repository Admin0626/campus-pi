<view class="word-native-screen"><view style="height:{{statusHeight}}px;background:#7872df"></view><view class="word-home-page"><view class="word-home-header"><button class="word-home-search" data-name="搜索" bindtap="pending">⌕　搜索信息、商品或任务..</button><view class="word-home-shortcuts"><button data-name="发布信息" bindtap="pending"><view>＋</view>发布信息</button><button data-name="二手交易" bindtap="pending"><view>♙</view>二手交易</button><button data-name="悬赏任务" bindtap="pending"><view>♧</view>悬赏任务</button><button data-name="交友广场" bindtap="pending"><view>♙</view>交友广场</button></view></view><view class="word-home-categories"><button class="selected" data-name="校园帖子" bindtap="pending">推荐</button><button data-name="失物招领" bindtap="pending">失物招领</button><button data-name="活动宣传" bindtap="pending">活动宣传</button></view><view wx:for="{{['热门信息','二手交易']}}" wx:key="*this" class="word-home-panel"><view><view class="word-panel-title">{{item}}</view><button data-name="{{item}}" bindtap="pending">查看更多</button></view><button class="word-home-pending" data-name="{{item}}" bindtap="pending">还在开发</button></view></view><view class="word-mobile-tabs"><button class="selected"><text class="word-native-icon">⌂</text>首页</button><button data-name="校园帖子" bindtap="pending"><text class="word-native-icon">◉</text>发现</button><button class="word-tab-publish" data-name="发布信息" bindtap="pending">＋</button><button data-name="私信与举报" bindtap="pending"><text class="word-native-icon">☏</text>私信</button><button  bindtap="me"><text class="word-native-icon">♙</text>个人</button></view></view>